# 必填：对外访问地址（订阅链接基于它生成），未设置时应用拒绝启动
PUBLIC_BASE_URL=https://sub.example.com
ALLOW_REGISTRATION=false
AUTH_COOKIE_SECURE=true
# 必填：至少 32 个随机字符，生成方法：openssl rand -hex 32
# 保留下面的占位值会导致应用启动失败，必须替换
CSRF_SECRET=replace-with-output-of-openssl-rand-hex-32
# 可信反向代理网段（逗号分隔），只有来自这些地址的连接才信任 X-Forwarded-For。
# 端口只绑本机时，经 docker-proxy 进入的连接对端是 docker 网关(172.x)，需包含 172.16.0.0/12
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
# mihomo 校验使用的工作目录，默认在数据卷内，一般无需修改
# MIHOMO_HOME=/app/data/mihomo-home
# 首次运行 mihomo 校验的超时（秒）：首次需初始化工作目录，可能比常规校验慢
# MIHOMO_FIRST_RUN_TIMEOUT=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ACCOUNT_FAILURES=5
AUTH_RATE_LIMIT_IP_FAILURES=20
# 注册频率限制：同一 IP 在窗口内最多注册次数（仅 ALLOW_REGISTRATION=true 时生效）
REGISTER_RATE_LIMIT_PER_WINDOW=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
# 远程订阅抓取的总耗时上限（秒），防止对端慢速逐块发送拖住请求
EXTERNAL_FETCH_DEADLINE_SECONDS=30
ADMIN_USERNAME=admin
# 可选：留空则不创建管理员。若该用户名已被普通用户占用，不会自动提权；
# 管理员已存在时不会用这里的值覆盖其密码。
ADMIN_PASSWORD=
API_PORT=8000
# 仅 docker-compose.prod.yml 使用：生产建议固定为 sha-<提交短哈希>
# IMAGE_TAG=main
RULESET_CACHE_ENABLED=true
RULESET_UPDATE_INTERVAL=604800
RULESET_CACHE_DIR=/app/ruleset/dustinwin
